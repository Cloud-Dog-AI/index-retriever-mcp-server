# index-retriever-mcp-server — external user env example (W28A-832)
#
# External-safe: placeholder embedding/VDB
# endpoints. Embedding + vector-DB backends are only contacted on ingest/query,
# not at startup, so the surfaces come up for a smoke without them reachable.
# Local Docker smoke:
#   docker run --rm --network host \
#     -e CLOUD_DOG_ENV_FILE=/app/env.example \
#     -v "$PWD/env.example:/app/env.example:ro" \
#     cloud-dog/index-retriever-mcp-server:<tag>

# ---- server ports (all-in-one) ----
CLOUD_DOG__API_SERVER__HOST=0.0.0.0
CLOUD_DOG__API_SERVER__PORT=8083
CLOUD_DOG__MCP_SERVER__HOST=0.0.0.0
CLOUD_DOG__MCP_SERVER__PORT=8081
CLOUD_DOG__WEB_SERVER__PORT=8080
CLOUD_DOG__A2A_SERVER__PORT=8082

# ---- auth (set your own keys) ----
CLOUD_DOG__INDEX__AUTH__API_KEYS=changeme
TEST_A2A_API_KEY=changeme

# ---- embeddings (set your own provider; OpenRouter base shown as placeholder) ----
CLOUD_DOG__INDEX__EMBEDDING__PROVIDER=openai
CLOUD_DOG__INDEX__EMBEDDING__MODEL=text-embedding-3-small
CLOUD_DOG__INDEX__EMBEDDING__BASE_URL=https://openrouter.ai/api/v1
EMBED_BASE_URL=https://openrouter.ai/api/v1
EMBED_API_KEY=

# ---- vector DB (set to your own reachable instance; placeholder for smoke) ----
CLOUD_DOG__INDEX__VDB__PROVIDER=qdrant
INDEX_RETRIEVER_DEFAULT_BACKEND=qdrant
CLOUD_DOG__INDEX__VDB__QDRANT_URL=http://localhost:6333
QDRANT_URL=http://localhost:6333
CHROMA_URL=http://localhost:8000
CLOUD_DOG__INDEX__VDB__CHROMA_URL=http://localhost:8000

# ---- local database ----
DB_URL=sqlite+aiosqlite:////app/data/index-retriever.db
INDEX_RETRIEVER_DB_URL=sqlite+aiosqlite:////app/data/index-retriever.db
CLOUD_DOG__INDEX__DB__URL=sqlite+aiosqlite:////app/data/index-retriever.db
CLOUD_DOG__DB__DIALECT=sqlite
CLOUD_DOG__DB__DATABASE=/app/data/index-retriever.db

# ---- publication smoke startup ----
# Disable baked bootstrap seeding for external smoke so startup does not contact
# a live vector DB before ingest/query operations are invoked.
INDEX_RETRIEVER_BOOTSTRAP_SEED_DISABLED=true
