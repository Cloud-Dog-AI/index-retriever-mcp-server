# syntax=docker/dockerfile:1
# index-retriever-mcp-server — Dockerfile.public (PS-97 v1.1 §1.1.3)
#
# PUBLIC variant — for external / GitHub-boundary builds (e.g. ghcr.io, Docker Hub).
# Uses the active package index supplied by the build environment via the
# BuildKit `pip_conf` secret (docker-build.sh writes it). No internal index,
# host, CA, or topology is referenced here.
#
# Development and CI variants can provide their own package index and CA inputs.
#
# Select via: docker-build.sh --variant public  (the default)
#
# NOTE: the Cloud-Dog platform packages (cloud-dog-config, cloud-dog-logging,
# cloud-dog-cache, cloud-dog-api-kit, cloud-dog-idam, cloud-dog-db, cloud-dog-jobs,
# cloud-dog-storage, cloud-dog-llm, cloud-dog-vdb) MUST be available on the
# active public index (e.g. pypi.org, or built from the GitHub-mirrored source
# per PS-97 §3.3) before this Dockerfile can build successfully end-to-end. That
# publish step is tracked separately in the W28A-86x publication chain.

# ── Builder ──────────────────────────────────────────────────────
FROM python:3.12-slim AS builder

ARG HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy
ENV HTTP_PROXY=${HTTP_PROXY} HTTPS_PROXY=${HTTPS_PROXY} NO_PROXY=${NO_PROXY} \
    http_proxy=${http_proxy} https_proxy=${https_proxy} no_proxy=${no_proxy}

WORKDIR /app

# Public build — no private CA overlay. System ca-certificates trust store is
# sufficient for public or boundary-provided package indexes.
#
# lxml / xmlsec are source-built (PIP_NO_BINARY) to match the pinned versions
# the platform IDAM / SAML stack requires, so the XML toolchain + zlib headers
# are installed here.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates gcc \
    libxml2-dev \
    libxmlsec1-dev \
    libxmlsec1-openssl \
    libxslt1-dev \
    pkg-config \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# Platform packages + project. The active index is provided by the caller via
# the `pip_conf` BuildKit secret (PS-97 §3.3 single-index; never --extra-index-url,
# never a hardcoded internal host). Versions are pinned to the project contract.
COPY REQUIREMENTS.txt pyproject.toml README.md ./
COPY src/ ./src/
RUN --mount=type=secret,id=pip_conf,target=/etc/pip.conf \
    --mount=type=secret,id=pip_netrc,target=/root/.netrc,required=false \
    pip install --no-cache-dir \
      "cloud-dog-config==0.3.5" \
      cloud-dog-logging==0.4.1 \
      "cloud-dog-cache==0.2.3" \
      "cloud-dog-api-kit==0.14.1" \
      "cloud-dog-idam==0.5.4" \
      cloud-dog-db==0.3.3 \
      "cloud-dog-jobs==0.4.4" \
      cloud-dog-storage==0.1.8 \
      "cloud-dog-llm==0.4.1" \
      "cloud-dog-vdb==0.5.6"
RUN --mount=type=secret,id=pip_conf,target=/etc/pip.conf \
    --mount=type=secret,id=pip_netrc,target=/root/.netrc,required=false \
    pip install --no-cache-dir -r REQUIREMENTS.txt
COPY ui/ ./ui/
RUN --mount=type=secret,id=pip_conf,target=/etc/pip.conf \
    --mount=type=secret,id=pip_netrc,target=/root/.netrc,required=false \
    pip install --no-cache-dir --no-deps .

# ── Final ────────────────────────────────────────────────────────
FROM python:3.12-slim
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.vendor="Cloud-Dog, Viewdeck Engineering Limited"

ARG HTTP_PROXY HTTPS_PROXY NO_PROXY http_proxy https_proxy no_proxy
ENV HTTP_PROXY=${HTTP_PROXY} HTTPS_PROXY=${HTTPS_PROXY} NO_PROXY=${NO_PROXY} \
    http_proxy=${http_proxy} https_proxy=${https_proxy} no_proxy=${no_proxy}

# Public runtime — no private CA overlay.
# iproute2 is required by server_control.sh port-probing (AGENT-LESSONS).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl iproute2 netcat-openbsd procps net-tools socat \
    libxml2 \
    libxmlsec1 \
    libxmlsec1-openssl \
    libxslt1.1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY REQUIREMENTS.txt pyproject.toml README.md ./
COPY src/ ./src/
COPY ui/ ./ui/
COPY database/ ./database/
COPY defaults.yaml server_control.sh docker-entrypoint.sh healthcheck.sh ./
# Durable admin-state seed (users/groups/collections/api-keys).
# Token values are not in this file; only placeholder references are copied.
COPY config/ ./config/

RUN mkdir -p /app/logs /app/data /app/.pids /app/certs && \
    chmod +x /app/docker-entrypoint.sh /app/healthcheck.sh /app/server_control.sh

RUN useradd --system --create-home --uid 10001 appuser && \
    chown -R appuser:appuser /app
USER appuser

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src \
    CLOUD_DOG__INDEX__API_SERVER__HOST=0.0.0.0 \
    CLOUD_DOG__INDEX__API_SERVER__PORT=8074 \
    CLOUD_DOG__INDEX__WEB_SERVER__HOST=0.0.0.0 \
    CLOUD_DOG__INDEX__WEB_SERVER__PORT=8075 \
    CLOUD_DOG__INDEX__MCP_SERVER__HOST=0.0.0.0 \
    CLOUD_DOG__INDEX__MCP_SERVER__PORT=8076 \
    CLOUD_DOG__INDEX__A2A_SERVER__HOST=0.0.0.0 \
    CLOUD_DOG__INDEX__A2A_SERVER__PORT=8077 \
    CLOUD_DOG__INDEX__VDB__PROVIDER=chroma \
    CLOUD_DOG__INDEX__EMBEDDING__PROVIDER=ollama \
    CLOUD_DOG__INDEX__EMBEDDING__MODEL=nomic-embed-text \
    CLOUD_DOG__INDEX__DB__URL=sqlite+aiosqlite:////app/data/index_retriever.db

EXPOSE 8074 8075 8076 8077

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=5 \
  CMD /app/healthcheck.sh

ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["all"]
