# index-retriever-mcp-server environment variables
# Copy to private/.env and fill in values

# Server
INDEX_MCP_HOST=0.0.0.0
INDEX_MCP_PORT=8686
INDEX_MCP_MCP_PORT=8687
INDEX_MCP_MCP_ENABLED=true

# Auth
INDEX_MCP_AUTH_MODE=apikey+jwt
API_KEY=change_me
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=

# Vault (loaded via env-vault, but can be overridden)
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=
# VAULT_MOUNT_POINT=cloud_dog_ai
# VAULT_CONFIG_PATH=config

# Database (profiles, jobs, audit metadata)
DB_URL=sqlite:///data/index_retriever.db

# Audit
AUDIT_LOG_PATH=./data/audit/audit.jsonl

# Default embedding provider
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=nomic-embed-text

# Default VDB (Chroma local)
CHROMA_PATH=./data/chroma

# Optional Redis (job queue multiplier)
# REDIS_URL=

# Ingestion
INGEST_ROOT=./data/ingest
