# index-retriever-mcp-server — Docker Environment (PS-97 v1.1 §1.1.4 PUBLIC variant)
#
# PUBLIC variant — for external / GitHub-boundary deployments.
# Uses *.example.com placeholders with <your-...> tokens and public defaults.
# Deployment-specific variants can provide private endpoints outside this file.
#
# Copy to .env and fill in real endpoints + secrets before running.
# The published surfaces come up for a smoke without a reachable embedding or
# vector backend, because those backends are only contacted on ingest/query.

# ── Server Ports (canonical defaults from defaults.yaml) ─────────
CLOUD_DOG__INDEX__API_SERVER__HOST=0.0.0.0
CLOUD_DOG__INDEX__API_SERVER__PORT=8074
CLOUD_DOG__INDEX__WEB_SERVER__HOST=0.0.0.0
CLOUD_DOG__INDEX__WEB_SERVER__PORT=8075
CLOUD_DOG__INDEX__MCP_SERVER__HOST=0.0.0.0
CLOUD_DOG__INDEX__MCP_SERVER__PORT=8076
CLOUD_DOG__INDEX__A2A_SERVER__HOST=0.0.0.0
CLOUD_DOG__INDEX__A2A_SERVER__PORT=8077

# ── Authentication ───────────────────────────────────────────────
# Comma-separated "token:role" pairs for tool/API access (supply from your
# secret store). Roles: admin, writer, reader.
CLOUD_DOG__INDEX__AUTH__API_KEYS=<your-admin-token>:admin

# ── Embedding Configuration ─────────────────────────────────────
# Set to your own embedding provider. Placeholder shown for a local Ollama or a
# public OpenAI-compatible endpoint; the backend is only contacted on ingest/query.
CLOUD_DOG__INDEX__EMBEDDING__PROVIDER=ollama
CLOUD_DOG__INDEX__EMBEDDING__MODEL=nomic-embed-text
CLOUD_DOG__INDEX__EMBEDDING__BASE_URL=http://localhost:11434
EMBED_BASE_URL=http://localhost:11434
EMBED_API_KEY=<your-embedding-api-key>

# ── LLM Configuration (optional) ────────────────────────────────
CLOUD_DOG__INDEX__LLM__PROVIDER=ollama
CLOUD_DOG__INDEX__LLM__MODEL=qwen3:14b
CLOUD_DOG__INDEX__LLM__BASE_URL=http://localhost:11434

# ── Vector DB Configuration ─────────────────────────────────────
# Set to your own reachable instance; placeholders shown for a local smoke.
CLOUD_DOG__INDEX__VDB__PROVIDER=chroma
CLOUD_DOG__INDEX__VDB__CHROMA_URL=http://localhost:8000
CHROMA_URL=http://localhost:8000
QDRANT_URL=http://localhost:6333

# ── Local Database ──────────────────────────────────────────────
CLOUD_DOG__INDEX__DB__URL=sqlite+aiosqlite:////app/data/index_retriever.db
INDEX_RETRIEVER_DB_URL=sqlite+aiosqlite:////app/data/index_retriever.db

# ── Publication smoke startup ───────────────────────────────────
# Disable baked bootstrap seeding for external smoke so startup does not contact
# a live vector DB before ingest/query operations are invoked.
INDEX_RETRIEVER_BOOTSTRAP_SEED_DISABLED=true

# ── Logging ──────────────────────────────────────────────────────
CLOUD_DOG__INDEX__LOG__LEVEL=INFO
CLOUD_DOG__INDEX__AUDIT__ENABLED=true

# ── Corporate Proxy (optional) ──────────────────────────────────
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost,.example.com

# ── TLS (optional) ──────────────────────────────────────────────
# Single combined bundle:
# CLOUD_DOG_TLS_CA_BUNDLE=/app/certs/ca-bundle.crt
