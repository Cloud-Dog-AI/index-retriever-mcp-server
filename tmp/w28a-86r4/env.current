REQUIRE_ALL_PDF_PARSERS=true
DEEPDOC_ENABLED=true
DEEPDOC_COMMAND="/opt/iac/Development/cloud-dog-ai/cloud-dog-ai-platform-standards/packages/backend/platform-vdb/.venv/bin/python /opt/iac/Development/cloud-dog-ai/cloud-dog-ai-platform-standards/packages/backend/platform-vdb/tests/tools/local_deepdoc_parser.py"
DOCLING_ENABLED=true
DOCLING_COMMAND="/opt/iac/Development/cloud-dog-ai/cloud-dog-ai-platform-standards/packages/backend/platform-vdb/.venv/bin/python /opt/iac/Development/cloud-dog-ai/cloud-dog-ai-platform-standards/packages/backend/platform-vdb/tests/tools/local_docling_parser.py"
TRANSFORMERS_ENABLED=true
TRANSFORMERS_COMMAND="/opt/iac/Development/cloud-dog-ai/cloud-dog-ai-platform-standards/packages/backend/platform-vdb/.venv/bin/python /opt/iac/Development/cloud-dog-ai/cloud-dog-ai-platform-standards/packages/backend/platform-vdb/tests/tools/local_transformers_parser.py"
MINERU_ENABLED=true
MINERU_FORMULA_ENABLE=false
MINERU_TABLE_ENABLE=false
MINERU_RETURN_MIDDLE_JSON=false
MINERU_RETURN_IMAGES=false
MARKER_MCP_ENABLED=true
MARKER_MCP_BASE_URL=https://marker0.cloud-dog.net
MINERU_BASE_URL=https://mineruapi.cloud-dog.net
# Parser timeout/retry/fallback settings — aligned with VDB env-IT
# See: platform-vdb/tests/env-IT and platform-vdb/tests/conftest.py
MARKER_MCP_TIMEOUT_SECONDS=360
MARKER_MCP_REQUEST_RETRIES=5
MARKER_MCP_ASYNC_THRESHOLD_SECONDS=30
MARKER_MCP_ASYNC_POLL_INTERVAL_SECONDS=5
MARKER_MCP_ASYNC_MAX_WAIT_SECONDS=600
MARKER_MCP_BUSY_RETRY_INITIAL_SECONDS=35
MARKER_MCP_BUSY_RETRY_MAX_SECONDS=420
MARKER_MCP_BUSY_RETRY_MAX_DELAY_SECONDS=60
MARKER_MCP_BUSY_RETRY_BACKOFF=1.5
MARKER_MCP_DOC_TIMEOUT_SECONDS=300
MINERU_TIMEOUT_SECONDS=180
MINERU_REQUEST_RETRIES=5
MINERU_DOC_TIMEOUT_SECONDS=120
MINERU_PAGE_FALLBACK_MAX_PAGES=24
MINERU_PAGE_FALLBACK_TARGET_CHARS=3200
DEEPDOC_TIMEOUT_SECONDS=180
DOCLING_TIMEOUT_SECONDS=180
TRANSFORMERS_TIMEOUT_SECONDS=180
